# Salin menjadi .env lalu isi nilainya. Jangan commit berkas .env.

# Wajib. Harus sama dengan WA_BOT_TOKEN di aplikasi web.
# Buat dengan: openssl rand -hex 32
API_TOKEN=ganti-token-bot

HOST=0.0.0.0
PORT=3001

# Folder sesi WhatsApp. Berisi kredensial, jangan pernah dibagikan.
WHATSAPP_AUTH_DIR=./auth_info

# Nomor yang menautkan bot. Kosongkan untuk memakai QR.
WHATSAPP_PAIRING_PHONE=

LOG_LEVEL=info
