# Salin menjadi .env lalu isi nilainya. Jangan commit berkas .env.

# Domain publik. Dipakai Caddy untuk sertifikat dan Caddyfile.
DOMAIN=pkl.sekolah.sch.id

# Database
DB_NAME=pkl_dev
DB_USER=pkl
DB_PASSWORD=ganti-sandi-database
DB_ROOT_PASSWORD=ganti-sandi-root

# Sesi: wajib, minimal 32 karakter. Buat dengan: openssl rand -base64 32
SESSION_SECRET=ganti-dengan-acak-panjang

# Bot WhatsApp. Nilai yang sama dipakai bot sebagai API_TOKEN.
# Buat dengan: openssl rand -hex 32
WA_BOT_TOKEN=ganti-token-bot
BOT_LOG_LEVEL=info

# Nomor WhatsApp yang menautkan bot. Kosongkan untuk memakai QR.
WHATSAPP_PAIRING_PHONE=

# Masuk dengan Google (opsional, boleh dikosongkan)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://DOMAIN/api/auth/google/callback

# Cloudflare Tunnel (opsional, hanya untuk pemasangan lewat tunnel)
TUNNEL_TOKEN=
